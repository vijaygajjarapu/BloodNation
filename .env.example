# Names only, with safe placeholder values. Never put real secrets in this file.
# Copy to .env (which is never committed) and fill in on your own computer.
APP_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-me-local-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_VERSION=0.1.0
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/bloodnation
REDIS_URL=redis://localhost:6379/0
# External services are mocked locally. No paid provider is chosen.
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
PUSH_PROVIDER=mock
MAPS_PROVIDER=mock
PAYMENTS_PROVIDER=mock
PROTECTED_CALL_PROVIDER=mock